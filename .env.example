# Copy the lines you need into your environment. kamayoq does not read a .env file.
KAMAYOQ_DATABASE_URL=postgresql://kamayoq:CHANGE_ME@127.0.0.1:5432/kamayoq
KAMAYOQ_HOST=127.0.0.1
KAMAYOQ_PORT=8000
KAMAYOQ_READINESS_TIMEOUT=2.0
KAMAYOQ_LOG_LEVEL=INFO
KAMAYOQ_API_DOCS=false
# KAMAYOQ_CONFIG_FILE=/etc/kamayoq/kamayoq.toml
